<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Target net6.0, not net8.0: the Emby Server app on macOS (and other
         native installs) runs on the .NET 6 runtime, which cannot load a
         net8.0 assembly (System.Runtime 8.0.0.0 missing) and drops the plugin
         with a ReflectionTypeLoadException. A net6.0 assembly loads on .NET 6,
         7 and 8 runtimes alike. -->
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>2.0.11.0</Version>
    <AssemblyVersion>2.0.11.0</AssemblyVersion>
    <FileVersion>2.0.11.0</FileVersion>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <HarmonyPackageVersion>2.4.2</HarmonyPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Legacy iframe metadata is excluded. Direct playback uses native VTT tracks. -->
    <Compile Remove="YouTubeCaptionMetadata.cs" />
    <Compile Remove="YouTubeRuntimeUpdater.cs;YouTubeRuntimePlatform.cs;YouTubeResolverProcess.cs" />
    <Compile Remove="tools/**/*.cs;.unlazy/**/*.cs" />
    <EmbeddedResource Include="Configuration\*.html" />
    <EmbeddedResource Include="Configuration\*.js" />
    <EmbeddedResource Include="Configuration\guide\*.png" />
    <EmbeddedResource Include="YouTubeEmbed.html" />
    <EmbeddedResource Include="ManagedResolver\License.txt" LogicalName="Emby.YouTubePlugin.ManagedResolver.License.txt" />
    <EmbeddedResource Include="$(PkgLib_Harmony)\lib\net6.0\0Harmony.dll" LogicalName="Emby.YouTubePlugin.Embedded.0Harmony.dll" />
    <EmbeddedResource Include="$(PkgLib_Harmony)\LICENSE" LogicalName="Emby.YouTubePlugin.Embedded.Harmony.LICENSE" />
    <EmbeddedResource Include="thumb.png" />
    <Content Include="thumb.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="$(HarmonyPackageVersion)" GeneratePathProperty="true" PrivateAssets="all" ExcludeAssets="all" />
    <PackageReference Include="MediaBrowser.Common" Version="4.9.1.90" />
    <PackageReference Include="MediaBrowser.Server.Core" Version="4.9.1.90" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
  </ItemGroup>

</Project>
